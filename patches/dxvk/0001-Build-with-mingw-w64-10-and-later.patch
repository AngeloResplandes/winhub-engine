From: WinHub <noreply@winhub.invalid>
Subject: [PATCH] Build with mingw-w64 10 and later.

Newer mingw-w64 headers define D3DDEVINFO_RESOURCEMANAGER and the ID3D10StateBlock
GUID, so the stand-ins no longer compile.
---
diff -u a/src/d3d10/d3d10_interfaces.h b/src/d3d10/d3d10_interfaces.h
--- a/src/d3d10/d3d10_interfaces.h	2026-10-11 20:50:08
+++ b/src/d3d10/d3d10_interfaces.h	2026-10-11 20:50:08
@@ -4,6 +4,7 @@
 
 #ifdef _MSC_VER
 struct __declspec(uuid("0803425a-57f5-4dd6-9465-a87570834a08")) ID3D10StateBlock;
-#else
+#elif !defined(__MINGW64_VERSION_MAJOR) || __MINGW64_VERSION_MAJOR < 10
+// mingw-w64 10 and later declare it in d3d10effect.h.
 __CRT_UUID_DECL(ID3D10StateBlock, 0x0803425a,0x57f5,0x4dd6,0x94,0x65,0xa8,0x75,0x70,0x83,0x4a,0x08);
 #endif
diff -u a/src/d3d9/d3d9_include.h b/src/d3d9/d3d9_include.h
--- a/src/d3d9/d3d9_include.h	2026-10-11 20:50:08
+++ b/src/d3d9/d3d9_include.h	2026-10-11 20:50:08
@@ -79,10 +79,13 @@
 
 // MinGW headers are broken. Who'dve guessed?
 #ifndef _MSC_VER
+// mingw-w64 10 and later define it.
+#if !defined(__MINGW64_VERSION_MAJOR) || __MINGW64_VERSION_MAJOR < 10
 typedef struct _D3DDEVINFO_RESOURCEMANAGER
 {
   char dummy;
 } D3DDEVINFO_RESOURCEMANAGER, * LPD3DDEVINFO_RESOURCEMANAGER;
+#endif
 
 #ifndef __WINE__
 extern "C" WINUSERAPI WINBOOL WINAPI SetProcessDPIAware(VOID);
