From 6d4e424fce35e92b8296f343b9c255de729e174a Mon Sep 17 00:00:00 2001
From: WinHub <noreply@winhub.invalid>
Date: Sun, 11 Oct 2026 16:06:08 -0300
Subject: [PATCH] winemac.drv: Export a function table for DXMT.

DXMT (Direct3D 10/11 over Metal) looks up macdrv_functions with dlsym() and expects the pre-Wine 10 layout of struct macdrv_win_data. Hand it a copy in that layout and create a client surface for windows that have no client view yet.
---
 dlls/winemac.drv/Makefile.in |   1 +
 dlls/winemac.drv/dxmt.c      | 119 +++++++++++++++++++++++++++++++++++
 2 files changed, 120 insertions(+)
 create mode 100644 dlls/winemac.drv/dxmt.c

diff --git a/dlls/winemac.drv/Makefile.in b/dlls/winemac.drv/Makefile.in
index 943a9b5..91f992d 100644
--- a/dlls/winemac.drv/Makefile.in
+++ b/dlls/winemac.drv/Makefile.in
@@ -28,6 +28,7 @@ SOURCES = \
 	cocoa_window.m \
 	display.c \
 	dllmain.c \
+	dxmt.c \
 	event.c \
 	gdi.c \
 	image.c \
diff --git a/dlls/winemac.drv/dxmt.c b/dlls/winemac.drv/dxmt.c
new file mode 100644
index 0000000..82f0747
--- /dev/null
+++ b/dlls/winemac.drv/dxmt.c
@@ -0,0 +1,119 @@
+/*
+ * Mac driver entry points for DXMT (Direct3D 10/11 over Metal)
