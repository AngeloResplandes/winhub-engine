+
+/* DXMT's unix library looks up a "macdrv_functions" table with dlsym() and
+ * creates its Metal view inside the window's client view. It expects the
+ * window data to start with { hwnd, cocoa_window, cocoa_view,
+ * client_cocoa_view }, an older layout of struct macdrv_win_data, so the
+ * table hands out a copy in that layout instead of the real structure.
+ * Windows only get a client view with a GL/Vulkan client surface, so one is
+ * created for windows that have none yet. */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+
+#include "macdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+struct dxmt_win_data
+{
+    HWND                     hwnd;
+    WineWindow              *cocoa_window;
+    WineContentView         *cocoa_view;
+    WineContentView         *client_cocoa_view;
+    struct macdrv_win_data  *data;  /* locked until dxmt_release_win_data */
+};
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct dxmt_win_data *ret;
+
+    if (!(data = get_win_data(hwnd))) return NULL;
+    if (!data->client_view)
+    {
+        /* Only windows with a GL/Vulkan client surface have a client view;
+         * give this one a surface too. Its reference is kept for the
+         * lifetime of the window, like a swapchain would. */
+        release_win_data(data);
+        TRACE("creating client surface for %p\n", hwnd);
+        if (!macdrv_CreateClientSurface(hwnd, 0, FALSE)) return NULL;
+        if (!(data = get_win_data(hwnd))) return NULL;
+        if (!data->client_view)
+        {
+            release_win_data(data);
+            return NULL;
+        }
+    }
+    if (!(ret = calloc(1, sizeof(*ret))))
+    {
+        release_win_data(data);
+        return NULL;
+    }
+    ret->hwnd = data->hwnd;
+    ret->cocoa_window = data->cocoa_window;
+    ret->cocoa_view = data->client_view;
+    ret->client_cocoa_view = data->client_view;
+    ret->data = data;
+    return ret;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *win_data)
+{
+    if (!win_data) return;
+    release_win_data(win_data->data);
+    free(win_data);
+}
+
+/* Field order is part of the interface DXMT relies on; do not reorder. */
+struct macdrv_functions_t
+{
+    void *init_display_devices;
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    WineWindow *(*get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    id_MTLDevice (*create_metal_device)(void);
+    void (*release_metal_device)(id_MTLDevice device);
+    WineMetalView *(*view_create_metal_view)(WineContentView *view, id_MTLDevice device);
+    CAMetalLayer *(*view_get_metal_layer)(WineMetalView *view);
+    void (*view_release_metal_view)(WineMetalView *view);
+    void *on_main_thread;
+};
+
+__attribute__((visibility("default"))) const struct macdrv_functions_t macdrv_functions =
+{
+    NULL,
+    dxmt_get_win_data,
+    dxmt_release_win_data,
+    macdrv_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    NULL,
+};
