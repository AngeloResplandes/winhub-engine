# Pinned inputs of the WinHub engine. Every download is checked against its SHA-256 or commit.
# Bump ENGINE_REVISION whenever anything below, in patches/ or in src/ changes.

ENGINE_REVISION=2

# Wine: the LGPL sources CodeWeavers publishes for CrossOver (Wine plus their patches: msync,
# the Metal hooks in winemac.drv used by DXMT and D3DMetal, WoW64). Only sources/wine is built.
CROSSOVER_VERSION=26.3.0
WINE_VERSION=11.0
WINE_URL=https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
WINE_SHA256=ac99c8ca4b3848f3e81784135f023df266b61c2345726ea55a50b3e030dd6872

# Official WineHQ macOS build. WinHub installs it first and lays the engine over it: the engine
# replaces bin/ and lib/wine/ and keeps its libraries (freetype, gnutls, SDL2, MoltenVK...), which
# the Wine build also links against, and its wine-mono and wine-gecko.
WINE_BASE_URL=https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.18/wine-devel-11.18-osx64.tar.xz
WINE_BASE_SHA256=aa0ea4c82e636ae7bca2076387cb0a5affa26509ad13f119ecd0d62bd7ba6f82
WINE_BASE_SIZE=190974384
WINE_BASE_PREFIX="Wine Devel.app/Contents/Resources/wine"
# patches/wine/0002 matches the wine-mono version this build ships (share/wine/mono).

# DXMT: Direct3D 10/11 over Metal. v0.80 is the last MIT-licensed release.
DXMT_REPO=https://github.com/3Shain/dxmt.git
DXMT_TAG=v0.80
DXMT_COMMIT=589adb780354b461645b29999cefaf533594ee99

# LLVM 15 (exact major version required by DXMT's shader converter).
LLVM_REPO=https://github.com/llvm/llvm-project.git
LLVM_TAG=llvmorg-15.0.7
LLVM_COMMIT=8dfdcc7b7bf66834a761bd8de445840ef68e4d1a

# cJSON, the JSON reader inside winhubcompat.so.
CJSON_VERSION=1.7.18
CJSON_URL=https://github.com/DaveGamble/cJSON/archive/refs/tags/v1.7.18.tar.gz
CJSON_SHA256=3aa806844a03442c00769b83e99970be70fbef03735ff898f4811dd03b9f5ee5

# cabextract, needed by some winetricks verbs.
CABEXTRACT_VERSION=1.11
CABEXTRACT_URL=https://www.cabextract.org.uk/cabextract-1.11.tar.gz
CABEXTRACT_SHA256=b5546db1155e4c718ff3d4b278573604f30dd64c3c5bfd4657cd089b823a3ac6
